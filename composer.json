{
    "name": "welington98/glpi-preventivemaintenance",
    "description": "Plugin de Manutenção Preventiva para GLPI",
    "type": "glpi-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
